FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8080 \
    STACKCERT_ENV=production

WORKDIR /app

RUN addgroup --system stackcert && adduser --system --ingroup stackcert stackcert

COPY pyproject.toml README.md ./
COPY stackcert ./stackcert
COPY stackcert_service ./stackcert_service
COPY demo_data ./demo_data

RUN python -m pip install --upgrade pip && python -m pip install .

USER stackcert
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('PORT', '8080')}/api/health\", timeout=3).read()"

CMD ["sh", "-c", "python -m uvicorn stackcert_service.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
