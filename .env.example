STACKCERT_ENV=local
STACKCERT_PERSISTENCE_BACKEND=auto
STACKCERT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=
STACKCERT_DEMO_EXAMPLES=
STACKCERT_DEMO_OUTPUTS=
STACKCERT_DEMO_WEIGHTS=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Comma-separated id:<sha256-token-hash> entries for MCP-only machine tokens.
STACKCERT_MCP_MACHINE_TOKEN_HASHES=
# Optional scopes by token id, e.g. ci=mcp:read,deploy=mcp:read|mcp:write.
STACKCERT_MCP_MACHINE_TOKEN_SCOPES=
# Example backend-only provider secret for guard connector key refund_policy_guard.
# Do not expose provider secrets to VITE_* frontend variables.
STACKCERT_GUARD_SECRET_REFUND_POLICY_GUARD=
